# City Thief demo: correct types, short caching (so updates show quickly), compression
AddType application/javascript .js
AddType text/css .css
AddType model/gltf-binary .glb
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType model/gltf-binary "access plus 7 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript model/gltf-binary application/octet-stream
</IfModule>
